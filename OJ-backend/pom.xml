<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>top.everblue</groupId>
    <artifactId>oj-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>OJ modular monolith</name>
    <description>EverBlue online judge modular monolith</description>

    <modules>
        <module>oj-common</module>
        <module>oj-framework</module>
        <module>oj-api</module>
        <module>oj-system</module>
        <module>oj-teaching</module>
        <module>oj-problem</module>
        <module>oj-judge</module>
        <module>oj-contest</module>
        <module>oj-community</module>
        <module>oj-ai</module>
        <module>oj-analytics</module>
        <module>oj-admin</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <spring-boot.version>3.5.16</spring-boot.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <hutool.version>5.8.48</hutool.version>
        <jwt.version>0.13.0</jwt.version>
        <docker.java.version>3.3.6</docker.java.version>
        <lombok.version>1.18.42</lombok.version>
        <knife4j.version>4.5.0</knife4j.version>
        <swagger.version>1.6.8</swagger.version>
        <cos.version>5.6.155</cos.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito inline mock 需要自 attach（Java 21+ 默认禁止） -->
                        <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                        <!--
                          默认排除需要外部依赖（MySQL / Redis）的测试。
                          这些测试只在带数据库的环境下才有意义，而 CI 与大多数本地环境
                          都没有常驻的 MySQL/Redis；不排除会让 `mvn test` 直接失败，
                          结果就是所有人（包括 CI）都加上 -DskipTests 把测试整体跳过。
                          需要跑它们时用 -Pintegration 显式启用，见文件末尾的 profile。
                        -->
                        <excludes>
                            <exclude>**/OjApplicationTests.java</exclude>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          带数据库的完整测试：`./mvnw test -Pintegration`
          需要本机已启动 MySQL / Redis（可用 `docker compose -f compose.dev.yml up -d`）。
          该 profile 覆盖默认排除并显式包含 *IT，同时保留 Surefire 默认单测命名规则。
        -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- combine.self="override" 才能真正清空父配置的 excludes，
                                 否则 Maven 会把两处配置合并，排除依旧生效 -->
                            <excludes combine.self="override"/>
                            <!--
                              只清空 excludes 并不够：Surefire 默认的 includes 只有
                              Test* / *Test / *Tests / *TestCase 四种命名，
                              形如 LastAdminConcurrencyIT 的集成测试不会被选中。
                              因此这里必须显式列出 include，把默认命名规则与 *IT 一并纳入。
                            -->
                            <includes>
                                <include>**/Test*.java</include>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                                <include>**/*TestCase.java</include>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
