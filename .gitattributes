# 统一按 LF 换行，避免 Windows/macOS 协作时的整文件 diff
* text=auto eol=lf

# 明确的二进制文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.jar  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell 脚本必须是 LF
*.sh   text eol=lf

# 锁文件在 diff 中折叠，代码评审时默认不展开
package-lock.json  -diff linguist-generated
pnpm-lock.yaml     -diff linguist-generated
yarn.lock          -diff linguist-generated

# 语言统计：把迁移与文档归入正确类别
*.sql      text
docs/**    linguist-documentation
