# ============================================================
# MuseAlgo-OJ 前端生产镜像（多阶段构建：Node 构建 → Nginx 托管）
# ------------------------------------------------------------
# 构建（在仓库根目录执行）：
#   docker build -f deploy/Dockerfile.frontend -t musealgo-oj/frontend:latest .
#
# 推荐用发行构建入口（串行构建 + 注入 OCI 追溯标签 + 生成发行清单）：
#   scripts/build-release.sh
#
# 运行：
#   docker run -d -p 80:80 \
#     -v oj-coursewares:/var/www/coursewares:ro \
#     musealgo-oj/frontend:latest
#
# 说明：镜像内 Nginx 已配置 /api 反向代理到 `backend:8080`（容器名/服务名）。
#       若后端不在同一 Docker 网络，请修改 deploy/nginx.conf 中的 proxy_pass。
#       容器探活使用 /healthz（只返回 ok，不访问后端）。
# ============================================================

# ---------- 阶段 1：构建静态产物 ----------
FROM node:22-slim AS build
WORKDIR /app

# 国内网络较慢时可指定 npm 镜像源：
#   --build-arg NPM_REGISTRY=https://registry.npmmirror.com
ARG NPM_REGISTRY=""

COPY OJ-Frontend/package.json OJ-Frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi && \
    npm ci --no-audit --no-fund

COPY OJ-Frontend/ ./
RUN npm run build

# ---------- 阶段 2：Nginx 托管 ----------
FROM nginx:alpine

# 发行追溯标签：由 scripts/build-release.sh 注入
ARG GIT_SHA="unknown"
ARG BUILD_VERSION="dev"
ARG BUILD_TIME="unknown"
ARG BUILD_SOURCE="https://github.com/RasVz/MuseAlgo-OJ"

LABEL org.opencontainers.image.title="MuseAlgo-OJ frontend" \
      org.opencontainers.image.description="MuseAlgo-OJ 前端静态站点（Nginx，含 /api 反代与 /coursewares//uploads/ 静态目录）" \
      org.opencontainers.image.source="$BUILD_SOURCE" \
      org.opencontainers.image.revision="$GIT_SHA" \
      org.opencontainers.image.version="$BUILD_VERSION" \
      org.opencontainers.image.created="$BUILD_TIME"

# 去掉默认站点配置，换成本项目的
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/musealgo.conf

COPY --from=build /app/dist /usr/share/nginx/html

# /healthz 由 deploy/nginx.conf 提供：只返回 ok，不依赖后端，适合作为容器探活。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

EXPOSE 80
