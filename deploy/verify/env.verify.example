# ============================================================
# MuseAlgo-OJ 原生 Linux x86_64 验收环境变量模板（REL-02）
# ------------------------------------------------------------
# 复制为私有文件后填写：cp env.verify.example env.verify && chmod 600 env.verify
# 本文件不含任何口令；口令在目标机本地输入或用 600 权限私有文件提供。
# 不要把 env.verify 提交到仓库或复制进证据目录。
# ============================================================

# ---- 目标环境 ----
# 站点入口（前端 Nginx；本地验证可用 http://127.0.0.1）
REL02_BASE_URL=http://127.0.0.1

# 后端直连探针地址（默认只绑 127.0.0.1；若改 BACKEND_PORT 同步修改）
REL02_BACKEND_URL=http://127.0.0.1:8080

# Compose 文件与私有 env（相对仓库根目录）
REL02_COMPOSE_FILE=docker-compose.prod.yml
REL02_ENV_FILE=.env

# 独立验收项目名：必须随机生成且不与任何业务项目重名
REL02_PROJECT=musealgo-rel02-CHANGE_ME

# ---- 发行物（来自 REL-01 清单，必须钉不可变 ID/digest）----
REL02_CANDIDATE_SHA=CHANGE_ME
REL02_BACKEND_IMAGE=musealgo-oj/backend:CHANGE_ME
REL02_FRONTEND_IMAGE=musealgo-oj/frontend:CHANGE_ME

# ---- 证据与合成数据 ----
# 目标机私有证据目录（700；完成后复制回 outputs/dev-batch2-2026-10-21/rel02/evidence/）
REL02_EVIDENCE_DIR=~/musealgo-rel02-evidence

# 合成数据脚本创建的管理员/教师/学生账号前缀；脚本自动追加随机后缀
REL02_SYNTH_PREFIX=rel02

# ---- Judge0 ----
# 已部署的 Judge0 基础地址（后端 JUDGE0_URLS 使用；测试机常见 http://127.0.0.1:23520）
REL02_JUDGE0_URL=http://127.0.0.1:23520
# 判题矩阵单次提交间隔（秒）；受 /submission/submit 限流每用户 10 秒 1 次约束，不得小于 11
REL02_SUBMIT_INTERVAL_SECONDS=11

# ---- 脚本执行的二进制 ----
REL02_PYTHON=python3
REL02_DOCKER=docker
