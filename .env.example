# ============================================================
# MuseAlgo-OJ 环境变量模板
# ------------------------------------------------------------
# 复制为 .env 后填写真实值（.env 已在 .gitignore 中，不会入库）：
#     cp .env.example .env
#
# 两种启动方式都会读取本文件：
#   · Docker  Compose读取.env；开发可整份加载，生产只转发编排中列明的变量
#   · 本地    scripts/run-local.sh 会先 source 本文件再启动后端
#
# 必填项须填写；可选项不需要时保留注释，以使用默认值或降级行为。
# 显式空赋值会覆盖默认值；OJ_PUBLIC_BASE_URL 的同源部署是有意留空的例外。
# ============================================================

# ---------------- 必填 ----------------

# JWT 签名密钥。≥32 字节随机串，生成：openssl rand -base64 48
# 缺失或过短时后端启动即失败（快速失败，避免弱密钥被带上线）。
JWT_SECRET=

# 数据库口令。缺失时后端启动即失败（快速失败）。
#   · 生产：应用CRUD账号口令，使用 openssl rand -hex 32 生成，与下列两项各不相同
#   · 开发（compose.dev.yml）：可留空，compose 会固定覆盖为 123456
OJ_DB_PASS=

# 仅生产Compose必填：root仅供初始化/备份恢复，迁移账号仅在独立migrate服务中使用
OJ_DB_ROOT_PASS=
OJ_DB_MIGRATION_PASS=

# 生产发行镜像：用 scripts/build-release.sh 从干净候选提交构建，清单写在仓库外。
# 推荐把清单里的 images.backend.id（内容寻址 image ID）或 push 后的 RepoDigest 填在这里，
# 不用 :latest —— 否则升级/回滚无法证明运行的是哪个提交。不设置时兼容本地 latest。
#BACKEND_IMAGE=musealgo-oj/backend:2026-10-21
#FRONTEND_IMAGE=musealgo-oj/frontend:2026-10-21
# 也可直接钉 digest：musealgo-oj/backend@sha256:<64位十六进制>

# ---------------- 可选：数据库连接 ----------------
# 本地/Docker 内一般不用改：compose 会按服务名覆盖成 mysql / redis。

# 数据库主机（本地默认 127.0.0.1，容器内由 compose 覆盖为 mysql）
#OJ_DB_HOST=

# 数据库用户名（默认 root）
#OJ_DB_USER=

# ---------------- 可选：AI 教学助手 ----------------
# 不配置时 AI 相关功能自动降级（返回降级提示），其余功能不受影响。
#
# ⚠️ 「留空」与「不写」不等价：写成 `AI_MODEL=` 会让应用收到空字符串，
#    从而覆盖 application.yml 中的默认值，导致模型名或接口地址为空。
#    不需要这些配置时请整行注释掉，不要留成 `KEY=`。

# 大模型 API Key（默认对接 DeepSeek）
#DEEPSEEK_API_KEY=

# OpenAI Chat Completions 兼容的接口地址（不写则用 application.yml 的默认地址）
#DEEPSEEK_API_URL=

# 模型名（不写则用 application.yml 的默认模型）
#AI_MODEL=

# 管理中心 AI 服务主密钥：AES-256-GCM，Base64 32 字节，独立于 JWT。
# 仅在启用“后台管理服务”时使用；通过只读文件挂载，不要写在此文件或提交到 Git。
# 生成：openssl rand -base64 32 > /secure/path/oj_ai_master_key && chmod 600 /secure/path/oj_ai_master_key
# 然后叠加 deploy/compose.ai-service-secret.yml，并设置 OJ_AI_MASTER_KEY_FILE_HOST。
#OJ_AI_MASTER_KEY_FILE_HOST=

# 仅测试环境：允许连接本机/内网的精确完整 URL（逗号分隔），生产保持为空。
# 管理页没有“跳过地址校验”开关。
#OJ_AI_PRIVATE_TARGETS=

# ---------------- 可选：对象存储（头像 / 报告文件）----------------
# 不配置时不会导致上传功能不可用：后端会自动降级为本地磁盘存储，
# 文件落在 OJ_UPLOAD_DIR（默认 uploads）；返回地址由 OJ_PUBLIC_BASE_URL 决定。
# 走本地存储时，请确保前端 Nginx 也把 /uploads/ 指向同一目录，
# 否则浏览器拿到的地址打不开（见 deploy/nginx.conf 与 docs/DEPLOYMENT.md）。

#COS_SECRET_ID=
#COS_SECRET_KEY=
#COS_BASE_URL=

# ---------------- 可选：其他 ----------------

# Apple Silicon + Rosetta 判题出现 unable to mmap ExecutableHeap / signal 5 时设 false。
# 保留题目 memory_limit，切换为 Judge0 聚合内存限制；需验证目标判题机支持该模式。
#JUDGE0_PER_PROCESS_MEMORY_LIMIT=false

# 后端对外基础地址，用于生成本地上传文件的访问地址。
# 显式设 OJ_PUBLIC_BASE_URL= 时返回同源相对地址（/uploads/...）。
# 两份 Compose 已覆盖为空；原生/systemd 未设置时默认 http://localhost:8080。
# 原生同源部署请取消下一行注释并保持等号右侧为空；
# 上传资源不同源时填浏览器可访问的资源基础地址（如 https://files.example.com）。
#OJ_PUBLIC_BASE_URL=

# Meilisearch 主密钥，仅在使用 --profile extras 时生效（默认 oj-meili-dev-key）
#MEILI_MASTER_KEY=

# Markdown课件构建超时（秒），仅教师/管理员可触发；默认120秒
# OJ_SLIDEV_BUILD_TIMEOUT_SECONDS=120

# 报告任务与留存：HTML 在数据库内，不发布 COS URL。AI 与每周全量默认关闭。
# OJ_REPORT_WEEKLY_ENABLED=false
# OJ_REPORT_AI_ADVICE_ENABLED=false
# OJ_REPORT_RETENTION_CLEANUP_ENABLED=true
# OJ_REPORT_RETENTION_MONTHS=12
# OJ_REPORT_RETENTION_CRON=0 30 3 * * *
# 报告 worker（docker-compose.prod.yml 的 report-worker 服务）：
# 危险开关，默认 false。只在“不承接 web 流量”的 worker 专用实例上开启，
# 开启后 unhealthy 会以退出码 70 退出，交给 restart 策略重启。
# 同进程承接 web 流量时开启会连带中断在线请求。
# OJ_REPORT_WORKER_EXIT_ON_UNHEALTHY=true
# 重启次数上限（滚动窗口内），达到后停止重启并告警，需人工介入。
# OJ_REPORT_WORKER_MAX_RESTART_ATTEMPTS=5
# 报告 worker 执行槽位数，默认 2。通知投递与报告生成共用该实例。
# OJ_REPORT_WORKER_THREADS=2
# V64 升级时回收无租约的 GENERATING 旧任务，默认关闭。
# 只有旧同步入口与旧 worker 均已停止、旧队列已排空或明确人工处理后才允许改为 true。
OJ_REPORT_WORKER_RECOVER_LEGACY=false
# 链式重放/恢复：默认关闭，仅在备份与副本演练后临时开启维护窗口。
# OJ_SETTLEMENT_REPLAY_ENABLED=false

# ---------------- 首装管理员（无默认账号） ----------------
# 系统不在迁移中插入任何默认管理员。新装后按 docs/OPERATIONS.md「新装后的第一个管理员」：
#   1) 用注册页注册本人账号（注册固定为 STUDENT）
#   2) DBA 按 id+username 双重核对后单独执行 UPDATE user SET role=3 WHERE id=<数字ID> AND role=1;
#   3) 重新登录后台再分配其余角色。
# 不要为此新增默认账号或批量提权；恢复场景见 docs/OPERATIONS.md 的备份恢复章节。
